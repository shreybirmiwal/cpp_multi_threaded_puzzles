{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build active file (C++20)",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20", "-g", "-Wall", "-Wextra", "-pthread",
                "${file}", "-o", "${fileDirname}/build/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "build & run active file (C++20)",
            "type": "shell",
            "command": "mkdir -p build && /usr/bin/clang++ -std=c++20 -g -Wall -Wextra -pthread '${file}' -o 'build/${fileBasenameNoExtension}' && './build/${fileBasenameNoExtension}'",
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "clear": true }
        }
    ]
}
